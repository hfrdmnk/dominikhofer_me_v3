{{- /* Lists newsletter issues from Buttondown as posts that link to the archive copy. */ -}}
{{- $url := .Site.Params.newsletter.feed -}}
{{- $feed := dict -}}
{{- with try (resources.GetRemote $url) -}}
  {{- with .Err -}}
    {{- warnf "Skipping newsletter issues: %s" . -}}
  {{- else with .Value -}}
    {{- with try (transform.Unmarshal .) -}}
      {{- with .Err -}}
        {{- warnf "Skipping newsletter issues: %s" . -}}
      {{- else -}}
        {{- $feed = .Value -}}
      {{- end -}}
    {{- end -}}
  {{- else -}}
    {{- warnf "Skipping newsletter issues: %s returned no feed" $url -}}
  {{- end -}}
{{- end -}}

{{- $items := $feed.channel.item | default slice -}}
{{- if reflect.IsMap $items -}}
  {{- $items = slice $items -}}
{{- end -}}
{{- range $items -}}
  {{- $slug := path.Base (strings.TrimSuffix "/" .link) -}}
  {{- $.AddPage (dict
    "path" (printf "newsletter/%s" $slug)
    "title" .title
    "dates" (dict "date" (time.AsTime .pubDate))
    "params" (dict "newsletter" true "external_url" .link)
    "build" (dict "render" "never" "list" "always" "publishResources" false)
  ) -}}
{{- end -}}
