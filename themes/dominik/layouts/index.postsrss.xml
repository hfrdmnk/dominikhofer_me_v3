{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{ printf "<?xml-stylesheet href=\"/styles/rss.xsl\" type=\"text/xsl\"?>" | safeHTML }}
{{- $pages := where site.RegularPages "Section" "posts" }}
{{- $pages = where $pages "Params.archived" "ne" true }}
{{- $pages = $pages.ByDate.Reverse }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title | transform.XMLEscape }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description | transform.XMLEscape }}</description>
    <generator>Hugo -- gohugo.io</generator>
    <language>{{ site.Language.Locale }}</language>
    {{- with index $pages 0 }}
    <lastBuildDate>{{ .Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{- end }}
    <atom:link href="{{ "rss.xml" | absURL }}" rel="self" type="application/rss+xml" />
    {{- range $pages }}
    <item>
      <title>{{ .Title | default (.Summary | plainify | truncate 70) | transform.XMLEscape }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid isPermaLink="true">{{ strings.TrimSuffix "/" .Permalink }}</guid>
      {{- $description := printf "%s%s%s" (partial "rss-cover.html" .) .Content (partial "rss-post-footer.html" .) }}
      <description>{{ $description | transform.XMLEscape }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
