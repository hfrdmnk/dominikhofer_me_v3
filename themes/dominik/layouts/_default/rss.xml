{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $pages := where .RegularPages "Params.archived" "ne" true }}
{{- $pages = $pages.ByDate.Reverse }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ with .Title }}{{ . | transform.XMLEscape }} on {{ end }}{{ site.Title | transform.XMLEscape }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content{{ with .Title }} in {{ . | transform.XMLEscape }}{{ end }} on {{ site.Title | transform.XMLEscape }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    {{- with index $pages 0 }}
    <lastBuildDate>{{ .Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title | default (.Summary | plainify | truncate 70) | transform.XMLEscape }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{- $description := printf "%s%s" .Content (partial "rss-post-footer.html" .) }}
      <description>{{ $description | transform.XMLEscape }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
