{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dominikhofer-me",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  // Deploys go to dominikhofer-me.<account>.workers.dev. dominikhofer.me is attached
  // as a custom domain in the dashboard during the switch from Dokploy.
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    // Static files are served before the Worker runs, except these, whose CORS preflights the Worker answers.
    "run_worker_first": ["/.well-known/about.md", "/.well-known/contact.vcf", "/.well-known/following.opml"]
  },
  "observability": { "enabled": true },
  // Rebuilds the site every 2 hours through the Worker's scheduled() handler, which
  // starts the deploy workflow. Needs the GITHUB_DEPLOY_TOKEN secret: a fine-grained
  // token for this repository with "Actions: Read and write".
  "triggers": { "crons": ["0 */2 * * *"] },
  // Fediverse state: followers, keys, announced posts, replies and Fedify's cache.
  // Created on the first deploy; apply migrations with `pnpm db:migrate`.
  "d1_databases": [{ "binding": "DB", "database_name": "dominikhofer-me", "migrations_dir": "migrations" }],
  // Outgoing activities, delivered by the Worker's queue() handler.
  "queues": {
    "producers": [{ "binding": "FEDIFY_QUEUE", "queue": "dominikhofer-me-fedify" }],
    "consumers": [{ "queue": "dominikhofer-me-fedify", "max_retries": 10 }]
  }
}
