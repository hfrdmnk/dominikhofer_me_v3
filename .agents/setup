#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Keep toolchain versions and checksums aligned with .github/workflows/deploy.yml.
node_version=22.23.1
hugo_version=0.164.0

if [[ $(uname -m) != x86_64 ]]; then
    echo "This setup requires an x86_64 orb." >&2
    exit 1
fi

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

echo "Checking system prerequisites"
SECONDS=0
missing=()
for package in ca-certificates curl xz-utils; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
        missing+=("$package")
    fi
done
if (( ${#missing[@]} )); then
    sudo apt-get update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
fi
echo "System prerequisites ready (${SECONDS}s)"

echo "Preparing Node.js $node_version and Hugo $hugo_version"
SECONDS=0
if [[ $(node --version 2>/dev/null || true) != "v$node_version" ]]; then
    curl --fail --silent --show-error --location --retry 3 \
        "https://nodejs.org/dist/v${node_version}/node-v${node_version}-linux-x64.tar.xz" \
        --output "$tmp_dir/node.tar.xz"
    echo "9749e988f437343b7fa832c69ded82a312e41a03116d766797ac14f6f9eee578  $tmp_dir/node.tar.xz" | sha256sum --check
    sudo tar --extract --xz --file "$tmp_dir/node.tar.xz" --directory /usr/local --strip-components=1
fi
if [[ $(hugo version 2>/dev/null || true) != "hugo v${hugo_version}-"* ]]; then
    curl --fail --silent --show-error --location --retry 3 \
        "https://github.com/gohugoio/hugo/releases/download/v${hugo_version}/hugo_${hugo_version}_linux-amd64.tar.gz" \
        --output "$tmp_dir/hugo.tar.gz"
    echo "d9c8b17285ea4ec004d9f814273ea910f2051ce02c284993fd1f91ba455ae50d  $tmp_dir/hugo.tar.gz" | sha256sum --check
    sudo tar --extract --gzip --file "$tmp_dir/hugo.tar.gz" --directory /usr/local/bin hugo
fi
node --version
hugo version
echo "Toolchains ready (${SECONDS}s)"

echo "Installing locked npm dependencies"
SECONDS=0
npm ci --include=dev --no-audit --no-fund --prefer-offline
echo "Dependencies ready (${SECONDS}s)"

if [[ ! -f .env ]]; then
    cp -- .env.example .env
fi
