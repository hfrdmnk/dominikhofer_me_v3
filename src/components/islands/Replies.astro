---
import { getBlueskyReplies, type Reply } from "../../lib/bluesky";
import ReplyByEmail from "../ReplyByEmail.astro";
import ReplyItem from "../ReplyItem.astro";
import ReplyOnMastodon from "../ReplyOnMastodon.astro";
import { SITE } from "../../site";

interface Props {
  slug: string;
  title: string;
  url: string;
  atUri?: string;
}

const { slug, title, url, atUri } = Astro.props;
// Imported here so that prerendering never loads the Cloudflare bindings.
const { getFediverseReplies } = await import("../../federation/replies");
const [bluesky, fediverse] = await Promise.all([getBlueskyReplies(url, atUri), getFediverseReplies(slug)]);
const replies = [...bluesky.replies, ...fediverse].toSorted((a, b) => a.published.getTime() - b.published.getTime());
const count = (list: Reply[]): number => list.reduce((total, reply) => total + 1 + count(reply.replies), 0);
const total = count(replies);
Astro.response.headers.set("Cache-Control", "public, max-age=300");
---
<div class="post-reply__actions">
  <ReplyByEmail title={title} />
  {bluesky.postUrl && (
    <a class="reply-on-bluesky meta-link" href={bluesky.postUrl} target="_blank" rel="noopener noreferrer">
      {/* "bluesky" icon from central icons (https://centralicons.com/) */}
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M12.0012 11.4535C11.0788 9.53897 8.5657 5.97133 6.22962 4.21155C4.54403 2.9421 1.8125 1.95953 1.8125 5.08555C1.8125 5.70961 2.1691 10.3302 2.37861 11.0803C3.10583 13.688 5.75648 14.3531 8.11421 13.9507C3.99288 14.6543 2.94472 16.985 5.20884 19.3157C9.50879 23.7423 11.3892 18.2051 11.8707 16.7863C11.9598 16.5243 12.0012 16.4027 12.0012 16.5103C12.0012 16.4027 12.0426 16.5243 12.1317 16.7863C12.6132 18.2051 14.4936 23.7423 18.7936 19.3157C21.0577 16.985 20.0095 14.6543 15.8882 13.9507C18.2459 14.3531 20.8966 13.688 21.6238 11.0803C21.8333 10.3302 22.1899 5.70961 22.1899 5.08555C22.1899 1.95953 19.4587 2.9421 17.7728 4.21155C15.4367 5.97133 12.9236 9.53897 12.0012 11.4535Z" fill="currentColor" />
      </svg>
      <span>Reply on Bluesky</span>
    </a>
  )}
  <ReplyOnMastodon uri={new URL(`/ap/posts/${slug}`, SITE.url).href} />
</div>
{total > 0 && (
  <section class="replies" aria-labelledby="replies-title">
    <h2 class="replies__title" id="replies-title">{total === 1 ? "1 reply" : `${total} replies`}</h2>
    <ol class="replies__list">
      {replies.map((reply) => <ReplyItem reply={reply} />)}
    </ol>
  </section>
)}
