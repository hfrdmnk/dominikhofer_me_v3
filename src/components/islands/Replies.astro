---
import { getBlueskyReplies, type Reply } from "../../lib/bluesky";
import ReplyByEmail from "../ReplyByEmail.astro";
import ReplyItem from "../ReplyItem.astro";

interface Props {
  slug: string;
  title: string;
  url: string;
  atUri?: string;
}

const { slug, title, url, atUri } = Astro.props;
// Imported here so that prerendering never loads the Cloudflare bindings.
const { getFediverseReplies } = await import("../../federation/replies");
const [bluesky, fediverse] = await Promise.all([getBlueskyReplies(url, atUri), getFediverseReplies(slug)]);
const replies = [...bluesky.replies, ...fediverse].toSorted((a, b) => a.published.getTime() - b.published.getTime());
const count = (list: Reply[]): number => list.reduce((total, reply) => total + 1 + count(reply.replies), 0);
const total = count(replies);
Astro.response.headers.set("Cache-Control", "public, max-age=300");
---
{total > 0 && (
  <section class="replies" aria-labelledby="replies-title">
    <h2 class="replies__title" id="replies-title">{total === 1 ? "1 reply" : `${total} replies`}</h2>
    <ol class="replies__list">
      {replies.map((reply) => <ReplyItem reply={reply} />)}
    </ol>
  </section>
)}
<p class="post-reply__actions">
  <ReplyByEmail title={title} />
  {bluesky.postUrl && (
    <a class="reply-on-bluesky meta-link" href={bluesky.postUrl} target="_blank" rel="noopener noreferrer">
      {/* Bluesky icon from OpenWeb Icons (https://pfefferle.dev/openwebicons/) */}
      <svg viewBox="0 100 1000 1000" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M259.248 276.171C356.699 349.332 461.512 497.674 500 577.276c38.488-79.601 143.301-227.944 240.752-301.107C811.067 223.383 925 182.536 925 312.51c0 25.958-14.882 218.056-23.611 249.246-30.341 108.424-140.901 136.079-239.25 119.341C834.047 710.353 877.777 807.265 783.333 904.177c-179.368 184.055-257.801-46.18-277.899-105.174-3.684-10.815-5.408-15.875-5.434-11.572-0.025-4.302-1.749 0.757-5.434 11.572-20.098 58.994-98.531 289.229-277.899 105.174-94.444-96.912-50.716-193.824 121.194-223.081-98.349 16.738-208.908-10.917-239.25-119.342C89.882 530.565 75 338.465 75 312.508 75 182.536 188.934 223.381 259.248 276.171Z" />
      </svg>
      <span>Reply on Bluesky</span>
    </a>
  )}
</p>
