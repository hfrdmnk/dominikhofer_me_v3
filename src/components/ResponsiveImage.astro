---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { DEFAULT_SIZES, DEFAULT_WIDTHS } from "../markdown/plugins.mjs";

interface Props {
  image: ImageMetadata;
  alt?: string;
  class?: string;
  pictureClass?: string;
  sizes?: string;
  widths?: number[];
  loading?: "lazy" | "eager";
  decoding?: "async" | "sync" | "auto";
}

const {
  image,
  alt = "",
  class: className,
  pictureClass,
  sizes = DEFAULT_SIZES,
  widths = DEFAULT_WIDTHS,
  loading,
  decoding,
} = Astro.props;

const processable = image.format !== "svg";
const srcset = async (format: "avif" | "webp") =>
  (await getImage({ src: image, format, widths })).srcSet.attribute;
const [avif, webp] = processable ? await Promise.all([srcset("avif"), srcset("webp")]) : [];
---
{processable ? (
  <picture class={pictureClass}>
    <source type="image/avif" srcset={avif} sizes={sizes} />
    <source type="image/webp" srcset={webp} sizes={sizes} />
    <img src={image.src} alt={alt} width={image.width} height={image.height} class={className} loading={loading} decoding={decoding} />
  </picture>
) : (
  <img src={image.src} alt={alt} class={className} loading={loading} decoding={decoding} />
)}
